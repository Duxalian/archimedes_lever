{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(*--no-verify*)",
      "Bash(git *core.hooksPath*)",
      "Bash(git * push*--force*)",
      "Bash(git * push* -f*)",
      "Bash(git -* reset --hard*)",
      "Bash(git -* clean*)",
      "Bash(git stash*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D*)",
      "Bash(git *hookspath*)",
      "Bash(git *HOOKSPATH*)",
      "Bash(git * stash*)",
      "Bash(git * restore *)",
      "Bash(git * branch -D*)",
      "Bash(git * checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git * checkout .*)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git *--discard-changes*)",
      "Bash(git *branch --delete --force*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/stop_check.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/first_use_check.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ]
    },
    "excludedCommands": [
      "scripts/session_checkin.sh",
      "bash scripts/session_checkin.sh"
    ]
  }
}
